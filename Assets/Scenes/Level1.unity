  descriptions:
  - "\u666E\u901A\u5BA2\u6236\n\u4ECB\u7D39:\u5E73\u5E73\u7121\u5947\u7684\u5BA2\u6236\u6C92\u6709\u4EFB\u4F55\u7279\u5225\u7684\u80FD\u529B\u3002"
  - "\u5916\u8A9E\u5BA2\u6236\n\u4ECB\u7D39:\u8AAA\u5916\u8A9E\u7684\u5BA2\u6236\u53EA\u6709\u6703\u8AAA\u5916\u8A9E\u7684zx\u5854\u53EF\u4EE5\u653B\u64CA\u4ED6\uFF0C\u5176\u4ED6\u7684\u5854\u90FD\u7121\u6CD5\u653B\u64CA\u4ED6\u3002"
  - "\u5967\u5BA2\n\u4ECB\u7D39:\u81C9\u76AE\u539A\u7684\u5BA2\u4EBA\u4F86\u9B27\u4E8B\u7684\uFF0C\u5854\u5C0D\u4ED6\u9020\u6210\u7684\u50B7\u5BB3\u53EA\u6709\u4E09\u5206\u4E4B\u4E00\uFF0C\u9664\u4E86\u4FDD\u5B89\u5B50\u797A\u5854\u4EE5\u5916\u3002"
  - "\u666E\u901A\u6B63\u786F\u5854\n\u4ECB\u7D39:\u5E73\u5E73\u7121\u5947\u7684\u54E1\u5DE5\u6C92\u6709\u4EFB\u4F55\u7684\u7279\u5225\u80FD\u529B\u3002"
  - "\u5916\u8A9Ezx\u5854\n\u4ECB\u7D39:\u6703\u8AAA\u5916\u8A9E\u7684\u7279\u5225\u54E1\u5DE5\u53EF\u4EE5\u653B\u64CA\u5916\u8A9E\u5BA2\u6236\u3002"
  - "\u4FDD\u5B89\u5B50\u797A\u5854\n\u4ECB\u7D39:\u5C08\u9580\u8655\u7406\u554F\u984C(\u4EBA)\u7684\u4FDD\u5B89\uFF0C\u4E0D\u53D7\u5967\u5BA2\u7684\u6E1B\u50B7\u3002"
  - "\u6B63\u5E38\u72C0\u614B\n\u6B63\u5E38\u72C0\u614B\u6C92\u6709\u4EFB\u4F55\u7279\u5225\u7684(\u7121\u804A\u597D\u60F3\u6478\u9B5A)"
  - "\u52AA\u529B\u72C0\u614B\n\u5728\u88AB\u8001\u95C6\u6B7B\u4EA1\u51DD\u8996\u4E00\u4E0B\u5F8C\u6703\u9032\u5165\u7684\u72C0\u614B\uFF0C\u6703\u6709\u5C0F\u5E45\u5EA6\u589E\u5E45(\u7562\u7ADF\u88AB\u8001\u95C6\u770B\u8457\u8981\u88DD\u52AA\u529B\u4E00\u4E0B\u5427)"
  - "\u760B\u72C2\u52AA\u529B\u72C0\u614B\n\u88AB\u8001\u95C6\u6B7B\u4EA1\u51DD\u8996\u5F88\u9577\u4E00\u6BB5\u6642\u9593\u5F8C\u6703\u9032\u5165\u7684\u72C0\u614B\uFF0C\u6703\u6709\u5927\u5E45\u5EA6\u589E\u5E45(\u88AB\u8001\u95C6\u4E00\u76F4\u76EF\u8457\u58D3\u529B\u5C71\u5927\u554A\u6211\u6709\u505A\u932F\u751A\u9EBC\u55CE\u4E0D\u6703\u88AB\u7092\u9B77\u9B5A\u5427)"
